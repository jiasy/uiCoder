    [<${State_Array}|self:stateChange(self.uiStates[1].stateName,true)| >]
    [<${BtnTipCode_Array}|-----btns----------------------------------------------------------| >]
    [<${BtnTipCode_Array}|${BtnTipCode_Array}| >]
    [<${BtnTipCode_Array}|--require("src.app.base.ui.btnGroup").new():initByBtnArr({self.btn1,self.btn2,....})--关联按钮形成按钮组| >]
end

--ui state change-------------------------------------
function c_${className}:stateChange(stateName_,rightNow_)
    --Logic here,then change state.
    --判断切换这个状态时候需要的操作，数据整理等等。
    c_${className}.super.stateChange(self,stateName_,rightNow_)
end

--ui structure change-------------------------------------
function c_${className}:uiStructureChange()
    --界面结构变化，需要做的操作。
    c_${className}.super.uiStructureChange(self)
end

--btn click call back---------------------------------------------------
function c_${className}:btnClicked(btnName_,rollName_,listName_,itemDataDict_)
    c_${className}.super.btnClicked(self,btnName_,rollName_,listName_,itemDataDict_)
    [<${BtnCheck_Array}|-----check btn name----------------------------------------------------------| >]
    [<${BtnCheck_Array}|${BtnCheck_Array}| >]
end

function c_${className}:onCreate()
    c_${className}.super.onCreate(self)
    --print(self.moduleName .. " : " .. self.className .. " : " .. "onCreate")
    --ui add logic here
end

function c_${className}:onDestory()
    --ui remove logic here
    --print(self.moduleName .. " : " .. self.className .. " : " .. "onDestory")
    c_${className}.super.onDestory(self)
end

return c_${className}