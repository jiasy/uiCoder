--class define--------------------------------------------------------
local C_disUI=require("src.app.base.ui.disUI")
local c_${className} = class("c_${className}",C_disUI)

--ui create------------------------------------------
function c_${className}:ctor(params_)
    c_${className}.super.ctor(self,params_)
    self.className="${className}"
    self.moduleName="${moduleName}"
    [<${isUi}|self.layerType="ui"|>]
end

--init data and place------------------------------------------
function c_${className}:init(initDict_)
    c_${className}.super.init(self,initDict_)
    [<${Init_Array}|-----ui init----------------------------------------------------------| >]
    local _specialDict={}--自定义数据初始化子UI
    local _avoidInitDict={}--避免在这里进行初始化的UI名称做KEY的字典。
    [<${Init_Array}|${Init_Array}| >]
    self:initSubUIs(_specialDict,_avoidInitDict)
    [<${State_Array}|-----state init----------------------------------------------------------| >]
