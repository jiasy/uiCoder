[<File_doc|ui|/src/app/ui/controls/${moduleName}/c_${className}.lua|nothing>]
[<File_doc|ui|/src/app/ui/controlsReplace/${moduleName}/c_${className}.lua|replace>]
--class define--------------------------------------------------------
local C_disUIBtn=require("src.app.base.ui.disUIBtn")
local c_${className} = class("c_${className}",C_disUIBtn)

--ui create------------------------------------------
function c_${className}:ctor(params_)
    c_${className}.super.ctor(self,params_)
    self.className="${className}"
    self.moduleName="${moduleName}"
    self.layerType="btn"
end

--init data and place------------------------------------------
function c_${className}:init(initDict_)
    c_${className}.super.init(self,initDict_)
    [<${Init_Array}|-----ui init----------------------------------------------------------| >]
    local _specialDict={}--自定义数据初始化子UI
    local _avoidInitDict={}--避免在这里进行初始化的UI名称做KEY的字典。
    [<${Init_Array}|${Init_Array}| >]
    self:initSubUIs(_specialDict,_avoidInitDict)
    -----state init----------------------------------------------------------
    self:stateChange("btnState1",true)
end

function c_${className}:initSubUIs()
    [<${Init_Array}|-----ui init----------------------------------------------------------| >]
    [<${Init_Array}|${Init_Array}| >]
end

function c_${className}:onCreate()
    c_${className}.super.onCreate(self)
    --print(self.moduleName .. " : " .. self.className .. " : " .. "onCreate")
    --ui add logic here
end

function c_${className}:onDestory()
    --ui remove logic here
    --print(self.moduleName .. " : " .. self.className .. " : " .. "onDestory")
    c_${className}.super.onDestory(self)
end

return c_${className}